{
  "name": "@veilpot/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "test:build-guard": "hardhat test test/ProductionBuildGuards.test.ts",
    "artifact:compare": "node --import=tsx scripts/generate-bytecode-reproducibility.ts",
    "lint:sol": "solhint --max-warnings 0 'contracts/**/*.sol'",
    "test": "hardhat test",
    "test:gate0": "hardhat test test/VeilDrawProbe.test.ts",
    "live:sepolia": "hardhat run --network sepolia scripts/run-sepolia.ts",
    "live:sepolia:check-init": "hardhat run --network sepolia scripts/check-sepolia-initialization.ts",
    "live:sepolia:interrupt": "cross-env VEILPOT_LIVE_STOP_AFTER=batch-generated hardhat run --network sepolia scripts/run-sepolia.ts",
    "live:sepolia:failure-drill": "cross-env VEILPOT_LIVE_RUN_FAILURE_DRILL=true hardhat run --network sepolia scripts/run-sepolia.ts",
    "live:sepolia:finalize": "cross-env VEILPOT_LIVE_FINALIZE=true hardhat run --network sepolia scripts/run-sepolia.ts"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "4.5.0",
    "cross-env": "7.0.3",
    "ethers": "6.16.0",
    "hardhat": "2.28.6",
    "mocha": "11.7.5",
    "solhint": "6.2.1",
    "ts-node": "10.9.2"
  }
}
